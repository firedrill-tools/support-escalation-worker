ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
EVENT_TOKEN=local-secret
ESCALATION_DB=workspace/escalation.db
ACTION_MODE=local
ALLOW_PIPEDREAM_ACTIONS=0
# To qualify Pipedream Connect with a development project:
PIPEDREAM_PROJECT_ID=
PIPEDREAM_CLIENT_ID=
PIPEDREAM_CLIENT_SECRET=
PIPEDREAM_EXTERNAL_USER_ID=
PIPEDREAM_SLACK_AUTH_PROVISION_ID=
PIPEDREAM_SLACK_CHANNEL=
# Optional access-token authentication. Choose this OR the client ID/secret pair.
PIPEDREAM_ACCESS_TOKEN=
PIPEDREAM_PROJECT_ENVIRONMENT=development
# Optional explicit API origin for a separately controlled development endpoint.
PIPEDREAM_BASE_URL=
